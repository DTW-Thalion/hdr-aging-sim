  "generated_by": "scripts/extract_lead_lag_phi.py (per cohort) + merge",
  "task": "HDR formalism repair Phase 1, deliverable D (docs/units_convention.md)",
  "specification": "Each pair is the cross-lagged fit used by scripts/elsa_lead_lag.py, scripts/inchianti_lead_lag.py and scripts/inchianti_6axis_analysis.py: d_target = beta*source_t0 + gamma*target_t0 + delta*age_t + const, where d_target = x_target(t+1) - x_target(t). Rearranged, x_target(t+1) = (1+gamma)*x_target(t) + beta*x_source(t) + ..., so the VAR(1) autoregressive coefficient of the target is phi_jj = 1 + gamma and the implied steady-state gain is beta/(1-phi_jj) = -beta/gamma.",
  "units": {
    "beta": "SD target per SD source per visit interval",
    "phi_jj": "dimensionless AR(1) coefficient per visit interval",
    "long_run_gain": "SD target per SD source at steady state (dimensionless)",
    "interval_years_*": "realised age gap between consecutive observations"
  },
  "provenance": {
    "ELSA": "run in-repo from data/elsa/ (UK Data Service SN 5050 extract); nurse-visit waves 2/4/6/8",
    "InCHIANTI": "run against a local copy of the InCHIANTI CD Share; participant-level data was not copied or exported, only these aggregate coefficients",
    "compiled_J": "data/J_matrix_compiled_9x9.csv",
    "rounding": "InCHIANTI rows are stored to 6 significant figures; they were computed on a machine holding the CD Share and only the aggregate coefficients were transferred. ELSA rows carry full double precision. Identities such as long_run_gain = beta/(1-phi_jj) therefore hold to ~1e-6 relative on InCHIANTI rows, exactly on ELSA rows."
  },
